          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "2. SEUILS ET PRIORISATION CONSERVÉS",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Négligeable : < 5 % ; faible : 5 à < 15 % ; modérée : 15 à < 30 % ; élevée : 30 à < 50 % ; critique : ≥ 50 %.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Actuel indéterminé : pression non évaluable. En étiage, « Négligeable » inclut aussi les stations avec Q2,7 mais sans prélèvements caractérisés ; leur pression reste vide.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "P1 : pression actuelle ou étiage ≥ 50 %.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "P2 : hors P1, pression actuelle ou étiage ≥ 30 %, ou amplification ≥ 15 points lorsque calculable.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Les autres statuts restent « Suivi courant », « Actuel non évaluable » et « Données insuffisantes ». Aucune nouvelle priorité P3.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Ce classement pilote la vigilance interne ; il ne constitue pas une décision réglementaire.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "fontWeight": "normal",
                      "color": "#1E293B"
                    }
                  }
                ]
              }
            ]
          }
        }
