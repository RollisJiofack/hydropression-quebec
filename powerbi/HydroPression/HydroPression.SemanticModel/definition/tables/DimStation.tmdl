table DimStation
	lineageTag: 1b76cd2b-f12e-4290-a70b-517a46620699

	measure 'Signalement station' =
			
			VAR CodeStation = SELECTEDVALUE ( FactPressionSnapshot[code] )
			RETURN
			    IF (
			        NOT ISBLANK ( CodeStation ),
			        LOOKUPVALUE (
			            DimStation[signalement_motif],
			            DimStation[code], CodeStation
			        ),
			        BLANK ()
			    )
		lineageTag: 4b628771-2536-490a-a011-dde6cbea95ae

	measure 'Stations avec signalement' =
			
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( DimStation[code] ),
			        REMOVEFILTERS (),
			        FILTER (
			            ALL ( DimStation ),
			            LEN ( TRIM ( COALESCE ( DimStation[signalement_motif], "" ) ) ) > 0
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 1a979fd1-003d-49ec-8f40-b3b48b469651

	/// Code de station. Champ recommande pour les tableaux, relations et info-bulles.
	column code
		dataType: string
		displayFolder: 01 - Station
		lineageTag: 2d1ad9e3-dbd7-4aac-a05b-cd9a8f0cb4cf
		summarizeBy: none
		sourceColumn: code

		annotation SummarizationSetBy = Automatic

	/// Nom de la station.
	column nom
		dataType: string
		displayFolder: 01 - Station
		lineageTag: 4a6771db-d5f3-4905-bdde-0c9422fa21e3
		summarizeBy: none
		sourceColumn: nom

		annotation SummarizationSetBy = Automatic

