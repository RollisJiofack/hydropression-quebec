table FactPressionSnapshot
	lineageTag: 830028b5-3b17-4a87-8ace-9ab231d46df1

	/// Dernier instant UTC disponible dans FactPressionSnapshot.
	measure 'Dernier instant UTC' =
			
			MAX ( FactPressionSnapshot[generated_at_utc] )
		formatString: yyyy-mm-dd hh:mm:ss
		displayFolder: 01 - KPI
		lineageTag: 673bfcdf-92b3-4d84-a457-690814d02a8c

	measure 'Stations suivies' =
			COALESCE ( (
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactPressionSnapshot[code] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
			), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: 9f16380d-8e4c-4b77-959f-518ae42a6e77

	measure 'Critiques etiage' =
			COALESCE ( (
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactPressionSnapshot[code] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant,
			        FactPressionSnapshot[categorie_etiage] = "critique"
			    )
			), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: 99c51328-436f-4c90-a906-ae3dcd1ed989

	measure 'Elevees etiage' =
			COALESCE ( (
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactPressionSnapshot[code] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant,
			        FactPressionSnapshot[categorie_etiage] = "eleve"
			    )
			), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: bab80d47-670f-413b-b140-a8e538161b1c

	measure 'Stations sous tension etiage' =
			COALESCE ( (
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( FactPressionSnapshot[code] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant,
			        FactPressionSnapshot[categorie_etiage] IN { "eleve", "critique" }
			    )
			), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: 67d07134-75b5-44a3-a5ee-76e95302d5ce

	/// Categorie d'etiage de la station selectionnee au dernier instant UTC. Mesure texte pour carte de fiche station.
	measure 'Categorie etiage station' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( FactPressionSnapshot[categorie_etiage], "Plusieurs" ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		displayFolder: 02 - Detail station
		lineageTag: 819a93db-7afa-437e-a2f3-c95c0c01603a

	measure 'Categorie actuelle station' =
			VAR UneStation = HASONEVALUE ( DimStation[code] ) || HASONEVALUE ( FactPressionSnapshot[code] )
			VAR Pression = [Pression actuelle station pct]
			RETURN IF ( NOT ( UneStation ), "Plusieurs", SWITCH ( TRUE (), ISBLANK ( Pression ), "inconnu", Pression >= 50, "critique", Pression >= 30, "eleve", Pression >= 15, "modere", Pression >= 5, "faible", "negligeable" ) )
		displayFolder: 02 - Detail station
		lineageTag: 7cd5b818-cec5-4bfb-bde3-36ad1a942af2

	/// Pression d'etiage de la station selectionnee au dernier instant UTC, exprimee sur l'echelle 0-100.
	measure 'Pression etiage station pct' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        MAX ( FactPressionSnapshot[pression_etiage_pct] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: 47d7be2a-f98f-483e-af38-78d7e2bffa3a

	measure 'Pression actuelle station pct' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN CALCULATE ( MAX ( FactPressionSnapshot[pression_observe_pct] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ) )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: babf9cc5-b93f-4fea-a8c4-cb19b97df670

	/// Q27 ete m3/s de la station selectionnee au dernier instant UTC.
	measure 'Q27 ete station m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        MAX ( FactPressionSnapshot[q27_ete_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: 66374741-be99-484f-9137-b6b6e3b243e6

	/// Debit preleve en etiage m3/s de la station selectionnee au dernier instant UTC.
	measure 'Debit preleve etiage station m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        MAX ( FactPressionSnapshot[debit_preleve_etiage_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: f3444589-63e3-4ed0-9d91-1a3dcbbe8484

	/// Debit preleve courant m3/s de la station selectionnee au dernier instant UTC.
	measure 'Debit preleve courant station m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        MAX ( FactPressionSnapshot[debit_preleve_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: 12cb3646-0ac2-4e4c-b991-98d2d3d7d48a

	measure 'Debit observe station m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN CALCULATE ( MAX ( FactPressionSnapshot[debit_obs_m3s] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ) )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: 72ca9b0f-c793-4beb-aa0c-52443c743a23

	measure 'Debit naturel station m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN CALCULATE ( MAX ( FactPressionSnapshot[debit_naturel_m3s] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ) )
		formatString: 0.00
		displayFolder: 02 - Detail station
		lineageTag: 382c5ff4-90b0-4f3a-be0b-46839da8c0bc

	/// Nombre de lignes intervenants reliees a la station selectionnee.
	measure 'Nombre intervenants station' = COUNTROWS ( FactIntervenants )
		formatString: 0
		displayFolder: 02 - Detail station
		lineageTag: 8cf4e294-09e4-4976-9a81-5d53261f1532

	measure 'Stations avec debit live' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN COALESCE ( CALCULATE ( DISTINCTCOUNT ( FactPressionSnapshot[code] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ), KEEPFILTERS ( NOT ISBLANK ( FactPressionSnapshot[debit_obs_m3s] ) ) ), 0 )
		formatString: 0
		displayFolder: 03 - Analyse
		lineageTag: f62201dd-bdf9-4064-93b6-66c7141ef326

	measure 'Stations sans pression actuelle' = COALESCE ( SUMX ( FILTER ( VALUES ( DimStation[code] ), NOT ( ISBLANK ( DimStation[code] ) ) ), IF ( ISBLANK ( CALCULATE ( [Pression actuelle station pct] ) ), 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 03 - Analyse
		lineageTag: 1f28b2bf-2b56-4ae6-8f5e-6e33146c527a

	measure 'Pression actuelle ponderee pct' =
			VAR DernierInstant = [Dernier instant UTC]
			VAR LignesRecentes = FILTER ( FactPressionSnapshot, FactPressionSnapshot[generated_at_utc] = DernierInstant && FactPressionSnapshot[statut_debit_observe] = "recent" && NOT ISBLANK ( FactPressionSnapshot[pression_observe_pct] ) )
			RETURN 100 * DIVIDE ( SUMX ( LignesRecentes, FactPressionSnapshot[debit_preleve_m3s] ), SUMX ( LignesRecentes, FactPressionSnapshot[debit_naturel_m3s] ) )
		formatString: 0.00
		displayFolder: 03 - Analyse
		lineageTag: 48d37c86-7b12-414a-a4ac-633a2b25cb5d

	/// Pression d'etiage ponderee sur le contexte filtre, exprimee sur l'echelle 0-100.
	measure 'Pression etiage ponderee pct' =
			VAR DernierInstant = [Dernier instant UTC]
			VAR DebitPreleveEtiage =
			    CALCULATE (
			        SUM ( FactPressionSnapshot[debit_preleve_etiage_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
			VAR DebitNaturelEtiage =
			    CALCULATE (
			        SUM ( FactPressionSnapshot[q27_ete_m3s] ) + SUM ( FactPressionSnapshot[debit_preleve_etiage_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
			RETURN
			    100 * DIVIDE ( DebitPreleveEtiage, DebitNaturelEtiage )
		formatString: 0.00
		displayFolder: 03 - Analyse
		lineageTag: 87655d4c-e7d4-495f-a825-5ca5241c0585

	measure 'Debit observe total m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN CALCULATE ( SUM ( FactPressionSnapshot[debit_obs_m3s] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ) )
		formatString: 0.00
		displayFolder: 03 - Analyse
		lineageTag: 45fdbefc-eee2-466f-aa34-b0546296cd73

	/// Somme du debit preleve courant m3/s sur le contexte filtre au dernier instant UTC.
	measure 'Debit preleve courant total m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        SUM ( FactPressionSnapshot[debit_preleve_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 03 - Analyse
		lineageTag: 1de47d17-8811-4294-98c2-8e0a4432aeba

	/// Somme du debit preleve en etiage m3/s sur le contexte filtre au dernier instant UTC.
	measure 'Debit preleve etiage total m3s' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        SUM ( FactPressionSnapshot[debit_preleve_etiage_m3s] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: 0.00
		displayFolder: 03 - Analyse
		lineageTag: 3a853da1-d6da-423c-9cf6-3fb547ba813d

	/// Rang de la station dans le contexte filtre, selon la pression actuelle observee decroissante.
	measure 'Rang pression actuelle' =
			RANKX (
			    ALLSELECTED ( DimStation[code] ),
			    [Pression actuelle station pct],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 03 - Analyse
		lineageTag: 64b78f85-b85c-477b-bef3-5ba48a655d55

	/// Rang de la station dans le contexte filtre, selon la pression d'etiage decroissante.
	measure 'Rang pression etiage' =
			RANKX (
			    ALLSELECTED ( DimStation[code] ),
			    [Pression etiage station pct],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 03 - Analyse
		lineageTag: 116d6f47-1180-424c-a1e7-1990e5acd54c

	/// Couleur hexadecimale associee a la categorie actuelle de la station selectionnee.
	measure 'Couleur categorie actuelle' =
			SWITCH (
			    [Categorie actuelle station],
			    "critique", "#a32424",
			    "eleve", "#d97a4a",
			    "modere", "#e6c14a",
			    "faible", "#7eb693",
			    "negligeable", "#1a4a3a",
			    "#b8b3a8"
			)
		displayFolder: 04 - Couleurs
		lineageTag: f2fbad9b-00a0-49f9-b75b-0a9547a9ecfb

	/// Couleur hexadecimale associee a la categorie d'etiage de la station selectionnee.
	measure 'Couleur categorie etiage' =
			SWITCH (
			    [Categorie etiage station],
			    "critique", "#a32424",
			    "eleve", "#d97a4a",
			    "modere", "#e6c14a",
			    "faible", "#7eb693",
			    "negligeable", "#1a4a3a",
			    "#b8b3a8"
			)
		displayFolder: 04 - Couleurs
		lineageTag: f42f871d-d510-4a94-99c7-6e0f4f180070

	/// Libelle de la station selectionnee. Mesure texte pour le titre de fiche station.
	measure 'Station selectionnee' = SELECTEDVALUE ( DimStation[station_label], "Selectionner une station" )
		displayFolder: 02 - Detail station
		lineageTag: ecfc6e57-a825-47b9-8178-f830f26d8f5d

	/// Code de la station selectionnee. Mesure texte pour fiche station.
	measure 'Code station selectionnee' = SELECTEDVALUE ( DimStation[code], BLANK () )
		displayFolder: 02 - Detail station
		lineageTag: f5336650-80c5-401a-9a04-54963763b354

	/// Plan d'eau de la station selectionnee. Mesure texte pour fiche station.
	measure 'Plan eau station' = SELECTEDVALUE ( DimStation[plan_deau], BLANK () )
		displayFolder: 02 - Detail station
		lineageTag: 8884aa2c-7910-458a-92d7-afb4386b0c54

	/// Bassin primaire de la station selectionnee. Mesure texte pour fiche station.
	measure 'Bassin primaire station' = SELECTEDVALUE ( DimStation[bv_prim], BLANK () )
		displayFolder: 02 - Detail station
		lineageTag: 5ff1e610-7dab-4d95-9156-49ad7ff64599

	/// Superficie du bassin de la station selectionnee en km2.
	measure 'Superficie bassin station km2' = SELECTEDVALUE ( DimStation[superficie_km2] )
		formatString: #,0.0
		displayFolder: 02 - Detail station
		lineageTag: 8ef3b5a7-a0cb-4055-ae1a-656d8d7972d8

	/// URL CEHQ de la station selectionnee, si disponible.
	measure 'URL CEHQ station' = SELECTEDVALUE ( DimStation[url_cehq], BLANK () )
		displayFolder: 02 - Detail station
		lineageTag: 8b95ac5c-8352-417a-b468-119b20daac8a

	/// Etat CEHQ de la station selectionnee au dernier instant UTC.
	measure 'Etat CEHQ station' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        SELECTEDVALUE ( FactPressionSnapshot[etat_cehq], BLANK () ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		displayFolder: 02 - Detail station
		lineageTag: ba8453b8-ec21-4cc8-b7c2-ebbeabdd7c93

	/// Date de mesure UTC de la station selectionnee au dernier instant UTC.
	measure 'Date mesure UTC station' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN
			    CALCULATE (
			        MAX ( FactPressionSnapshot[date_mesure_utc] ),
			        FactPressionSnapshot[generated_at_utc] = DernierInstant
			    )
		formatString: yyyy-mm-dd hh:nn:ss
		displayFolder: 02 - Detail station
		lineageTag: 3a47a848-3225-4786-9b73-e5590e7972a9

	measure 'Critiques actuelle' = COALESCE ( SUMX ( FILTER ( VALUES ( DimStation[code] ), NOT ( ISBLANK ( DimStation[code] ) ) ), VAR Pression = CALCULATE ( [Pression actuelle station pct] ) RETURN IF ( NOT ( ISBLANK ( Pression ) ) && Pression >= 50, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: 4bc789d7-1d43-4aaf-bc6f-a9f80d56901c

	measure 'Elevees actuelle' = COALESCE ( SUMX ( FILTER ( VALUES ( DimStation[code] ), NOT ( ISBLANK ( DimStation[code] ) ) ), VAR Pression = CALCULATE ( [Pression actuelle station pct] ) RETURN IF ( NOT ( ISBLANK ( Pression ) ) && Pression >= 30 && Pression < 50, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 01 - KPI
		lineageTag: d2c280f8-0605-4ab7-a9cc-fa57d6ba5bce

	/// Ecart en points entre la pression projetee en etiage et la pression actuelle de la station.
	measure 'Amplification étiage (points)' =
			VAR PressionActuelle = [Pression actuelle station pct]
			VAR PressionEtiage = [Pression etiage station pct]
			RETURN
			    IF (
			        ISBLANK ( PressionActuelle ) || ISBLANK ( PressionEtiage ),
			        BLANK (),
			        PressionEtiage - PressionActuelle
			    )
		formatString: 0.0
		displayFolder: 04 - Priorisation
		lineageTag: 202d3bc2-4fad-4783-8253-3a360a2efbcb

	/// Part des stations disposant d'une pression actuelle exploitable au dernier instant UTC.
	measure 'Couverture pression actuelle (%)' =
			VAR DernierInstant = [Dernier instant UTC]
			VAR TotalStations = CALCULATE ( DISTINCTCOUNT ( FactPressionSnapshot[code] ), FactPressionSnapshot[generated_at_utc] = DernierInstant )
			VAR StationsCalculables = CALCULATE ( DISTINCTCOUNT ( FactPressionSnapshot[code] ), FactPressionSnapshot[generated_at_utc] = DernierInstant, KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ), KEEPFILTERS ( NOT ISBLANK ( FactPressionSnapshot[pression_observe_pct] ) ) )
			RETURN DIVIDE ( COALESCE ( StationsCalculables, 0 ), TotalStations )
		formatString: 0.0%
		displayFolder: 04 - Priorisation
		lineageTag: d9b3913c-1301-4aba-85c5-b09cff7d8a8a

	/// Part des stations disposant d'un debit observe au dernier instant UTC.
	measure 'Couverture télémétrie (%)' =
			VAR DernierInstant = [Dernier instant UTC]
			VAR TotalStations = CALCULATE ( DISTINCTCOUNT ( FactPressionSnapshot[code] ), FactPressionSnapshot[generated_at_utc] = DernierInstant )
			RETURN DIVIDE ( [Stations avec debit live], TotalStations )
		formatString: 0.0%
		displayFolder: 04 - Priorisation
		lineageTag: 1ad730a5-8875-403c-861e-69af27315999

	measure 'Niveau de vigilance interne' =
			VAR Actuel = [Pression actuelle station pct]
			VAR Etiage = [Pression etiage station pct]
			VAR Amplification = [Amplification étiage (points)]
			RETURN SWITCH ( TRUE (), COALESCE ( Actuel, -1 ) >= 50 || COALESCE ( Etiage, -1 ) >= 50, "Priorité 1", COALESCE ( Actuel, -1 ) >= 30 || COALESCE ( Etiage, -1 ) >= 30 || ( NOT ( ISBLANK ( Amplification ) ) && Amplification >= 15 ), "Priorité 2", ISBLANK ( Actuel ) && ISBLANK ( Etiage ), "Données insuffisantes", ISBLANK ( Actuel ), "Actuel non évaluable", ISBLANK ( Etiage ), "Étiage non évaluable", "Suivi courant" )
		displayFolder: 04 - Priorisation
		lineageTag: a40eea35-55a8-4885-ba6a-5da19c5d3755

	measure 'Motif de vigilance' =
			VAR Actuel = [Pression actuelle station pct]
			VAR Etiage = [Pression etiage station pct]
			VAR Amplification = [Amplification étiage (points)]
			VAR Motif = SWITCH ( TRUE (), COALESCE ( Actuel, -1 ) >= 50, "Pression actuelle ≥ 50 %", COALESCE ( Etiage, -1 ) >= 50, "Risque d'étiage ≥ 50 %", COALESCE ( Actuel, -1 ) >= 30, "Pression actuelle ≥ 30 %", COALESCE ( Etiage, -1 ) >= 30, "Risque d'étiage ≥ 30 %", NOT ( ISBLANK ( Amplification ) ) && Amplification >= 15, "Amplification ≥ 15 points", "Suivi courant" )
			RETURN SWITCH ( TRUE (), ISBLANK ( Actuel ) && ISBLANK ( Etiage ), "Données insuffisantes : actuel et étiage non évaluables", ISBLANK ( Actuel ), IF ( Motif = "Suivi courant", "Actuel non évaluable; étiage sous 30 %", Motif & "; actuel non évaluable" ), ISBLANK ( Etiage ), Motif & "; étiage non évaluable", Motif )
		displayFolder: 04 - Priorisation
		lineageTag: ebaa675c-b89b-4053-a070-2940bbb90c57

	/// Nombre de stations en priorite 1 : pression actuelle ou risque en etiage d'au moins 50 %.
	measure 'Priorité 1 - stations' =
			VAR StationsEvaluees =
			    FILTER ( VALUES ( DimStation[code] ), NOT ( ISBLANK ( DimStation[code] ) ) )
			RETURN
			    SUMX (
			        StationsEvaluees,
			        VAR PressionActuelle = CALCULATE ( [Pression actuelle station pct] )
			        VAR PressionEtiage = CALCULATE ( [Pression etiage station pct] )
			        RETURN
			            IF (
			                COALESCE ( PressionActuelle, -1 ) >= 50
			                    || COALESCE ( PressionEtiage, -1 ) >= 50,
			                1,
			                0
			            )
			    )
		formatString: 0
		displayFolder: 04 - Priorisation
		lineageTag: a8911f04-1300-4d3e-9a3f-880d208f0842

	/// Nombre de stations en priorite 2 : niveau d'au moins 30 % ou amplification d'au moins 15 points, hors priorite 1.
	measure 'Priorité 2 - stations' =
			VAR StationsEvaluees =
			    FILTER ( VALUES ( DimStation[code] ), NOT ( ISBLANK ( DimStation[code] ) ) )
			RETURN
			    SUMX (
			        StationsEvaluees,
			        VAR PressionActuelle = CALCULATE ( [Pression actuelle station pct] )
			        VAR PressionEtiage = CALCULATE ( [Pression etiage station pct] )
			        VAR Amplification =
			            IF (
			                ISBLANK ( PressionActuelle ) || ISBLANK ( PressionEtiage ),
			                BLANK (),
			                PressionEtiage - PressionActuelle
			            )
			        VAR EstPriorite1 =
			            COALESCE ( PressionActuelle, -1 ) >= 50
			                || COALESCE ( PressionEtiage, -1 ) >= 50
			        VAR EstPriorite2 =
			            NOT ( EstPriorite1 )
			                && (
			                    COALESCE ( PressionActuelle, -1 ) >= 30
			                        || COALESCE ( PressionEtiage, -1 ) >= 30
			                        || ( NOT ( ISBLANK ( Amplification ) ) && Amplification >= 15 )
			                )
			        RETURN IF ( EstPriorite2, 1, 0 )
			    )
		formatString: 0
		displayFolder: 04 - Priorisation
		lineageTag: 1c755b7a-5aef-4101-a43c-3efbb123e616

	measure 'Derniere mesure CEHQ UTC' = MAX ( FactPressionSnapshot[date_mesure_utc] )
		formatString: yyyy-MM-dd HH:mm:ss
		displayFolder: 05 - Fraicheur
		lineageTag: 9b86600f-9e48-4721-aba3-7a00d2da67b8

	measure 'Collecte CEHQ UTC' = MAX ( FactPressionSnapshot[collected_at_utc] )
		formatString: yyyy-MM-dd HH:mm:ss
		displayFolder: 05 - Fraicheur
		lineageTag: 0ff2d7b3-0af2-4b74-9ea5-07dac02f0bd0

	measure 'Actualisation Power BI UTC' = MAX ( FactPressionSnapshot[refreshed_at_utc] )
		formatString: yyyy-MM-dd HH:mm:ss
		displayFolder: 05 - Fraicheur
		lineageTag: 611dcc0e-d170-41e3-afc2-05d4f8c0862d

	measure 'Age derniere mesure heures' = IF ( NOT ISBLANK ( [Derniere mesure CEHQ UTC] ), MAX ( 0, ( UTCNOW () - [Derniere mesure CEHQ UTC] ) * 24 ) )
		formatString: 0.0
		displayFolder: 05 - Fraicheur
		lineageTag: ae45c102-8574-4611-8831-5adcd0c88a4b

	measure 'Etat fraicheur des debits' = IF ( [Stations avec debit live] = 0, "Aucun debit recent (6 h)", FORMAT ( [Stations avec debit live], "0" ) & " / " & FORMAT ( [Stations suivies], "0" ) & " stations avec un debit recent (6 h)" )
		displayFolder: 05 - Fraicheur
		lineageTag: 05d00741-9b07-477c-b438-a705c47dee5b

	measure 'Age generation import heures' =
			VAR Generation = [Dernier instant UTC]
			VAR InstantImport = [Actualisation Power BI UTC]
			RETURN IF ( NOT ISBLANK ( Generation ) && NOT ISBLANK ( InstantImport ), ( InstantImport - Generation ) * 24 )
		formatString: 0.0
		displayFolder: 03 - Analyse
		lineageTag: 34ce2c5f-cdae-41a5-97a2-01ead0c50739

	measure 'Generation locale' =
			VAR DernierInstant = [Dernier instant UTC]
			RETURN CALCULATE ( SELECTEDVALUE ( FactPressionSnapshot[generated_at_local] ), FactPressionSnapshot[generated_at_utc] = DernierInstant )
		displayFolder: 03 - Analyse
		lineageTag: a5fdeb0d-be7a-4cd5-899f-c9cdc777d5fd

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Catégorie actuelle affichée' = SWITCH ( [Categorie actuelle station], "critique", "Critique", "eleve", "Élevée", "modere", "Modérée", "faible", "Faible", "negligeable", "Négligeable", "inconnu", "Indéterminée", "Sélectionner une station" )
		displayFolder: 06 - Revue visuelle
		lineageTag: f756de19-a3ab-4a8c-b67c-33906d6b6dcc

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Catégorie étiage affichée' = SWITCH ( [Categorie etiage station], "critique", "Critique", "eleve", "Élevée", "modere", "Modérée", "faible", "Faible", "negligeable", "Négligeable", "inconnu", "Indéterminée", "Sélectionner une station" )
		displayFolder: 06 - Revue visuelle
		lineageTag: 64808d19-f70e-43f8-a7d9-225902439c46

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Actuel affiché (%)' =
			VAR P = [Pression actuelle station pct]
			RETURN IF ( COUNTROWS ( FactPressionSnapshot ) = 0, BLANK (), IF ( ISBLANK ( P ), "Non éval.", FORMAT ( P, "0.0" ) & " %" ) )
		displayFolder: 06 - Revue visuelle
		lineageTag: 1e33fa5d-6829-400b-b6df-ba502072fd9d

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Étiage affiché (%)' =
			VAR P = [Pression etiage station pct]
			RETURN IF ( COUNTROWS ( FactPressionSnapshot ) = 0, BLANK (), IF ( ISBLANK ( P ), "Non éval.", FORMAT ( P, "0.0" ) & " %" ) )
		displayFolder: 06 - Revue visuelle
		lineageTag: b57e6a7c-ffed-4815-9b8d-544295c305ee

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Modérées actuelles' = COALESCE ( SUMX ( VALUES ( DimStation[code] ), VAR P = CALCULATE ( [Pression actuelle station pct] ) RETURN IF ( NOT ISBLANK ( P ) && P >= 15 && P < 30, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 33f4890d-91f9-4257-99a4-814c47888d3b

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Modérées étiage' = COALESCE ( CALCULATE ( [Stations suivies], KEEPFILTERS ( FactPressionSnapshot[categorie_etiage] = "modere" ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: ef3e4262-a54d-4dac-8983-09b69e22b4cb

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Stations caractérisées' = COALESCE ( CALCULATE ( [Stations suivies], KEEPFILTERS ( FactPressionSnapshot[prelevements_caracterises] = TRUE () ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 0c414e9d-02d4-4f04-893f-a7e28bdc5f37

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Stations non caractérisées' = COALESCE ( CALCULATE ( [Stations suivies], KEEPFILTERS ( FactPressionSnapshot[prelevements_caracterises] = FALSE () ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 2d8f8c26-4e8c-4a23-aa66-1d00acaac416

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Stations calculables' = COALESCE ( CALCULATE ( [Stations suivies], KEEPFILTERS ( FactPressionSnapshot[statut_debit_observe] = "recent" ), KEEPFILTERS ( NOT ISBLANK ( FactPressionSnapshot[pression_observe_pct] ) ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 2d0df0ca-5ebd-4ab8-9c9f-1b1da758d5ce

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Stations par catégorie' = [Stations suivies]
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: a24a2469-5b3d-495a-9195-78f00d113af6

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Part de la catégorie' = DIVIDE ( [Stations suivies], CALCULATE ( [Stations suivies], REMOVEFILTERS ( FactPressionSnapshot[categorie_etiage], FactPressionSnapshot[categorie_etiage_libelle], FactPressionSnapshot[categorie_etiage_ordre] ) ) )
		formatString: 0.0%
		displayFolder: 06 - Revue visuelle
		lineageTag: 96dea380-aab4-4bab-a77d-2c1255c1cb80

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Débit mensuel affiché (m3/s)' =
			VAR UneStation = HASONEVALUE ( DimStation[code] )
			VAR Caracterisee = SELECTEDVALUE ( FactPressionSnapshot[prelevements_caracterises], FALSE () )
			RETURN IF ( UneStation && Caracterisee, SUM ( FactDebitMensuel[debit_preleve_m3s] ), BLANK () )
		formatString: 0.000
		displayFolder: 06 - Revue visuelle
		lineageTag: 42280adf-67f5-4cca-98e0-22e76bb1937f

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'État du profil mensuel' =
			VAR Caracterisee = SELECTEDVALUE ( FactPressionSnapshot[prelevements_caracterises], FALSE () )
			RETURN IF ( NOT HASONEVALUE ( DimStation[code] ), "Sélectionner une seule station.", IF ( Caracterisee, "Profil moyen des prélèvements caractérisés; zéro déclaré distinct d'une donnée absente.", "Prélèvements non caractérisés : profil mensuel non évaluable, pas de zéro imputé." ) )
		displayFolder: 06 - Revue visuelle
		lineageTag: f9c370e5-2114-4585-a1a9-1303fc6f5800

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'État de la station' =
			VAR Statut = SELECTEDVALUE ( FactPressionSnapshot[statut_debit_observe] )
			VAR P = [Pression actuelle station pct]
			RETURN IF ( NOT HASONEVALUE ( DimStation[code] ), "Sélectionner une seule station", IF ( NOT ISBLANK ( P ), "Actuel calculable; débit récent à la génération", IF ( Statut = "recent", "Débit récent; prélèvements non caractérisés", "Actuel non évaluable : débit absent ou périmé à la génération" ) ) )
		displayFolder: 06 - Revue visuelle
		lineageTag: dbc1632b-e46d-491f-8486-f4cf6a20bf0f

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Fraîcheur affichée' = "Génération UTC " & FORMAT ( [Dernier instant UTC], "yyyy-MM-dd HH:mm" ) & "  |  Toronto " & SUBSTITUTE ( LEFT ( [Generation locale], 16 ), "T", " " ) & "  |  Import UTC " & FORMAT ( [Actualisation Power BI UTC], "yyyy-MM-dd HH:mm" ) & "  |  Validité des débits évaluée à la génération"
		displayFolder: 06 - Revue visuelle
		lineageTag: 6b97bf12-9353-47e4-9877-a7504153bc9d

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Filtre vigilance accepté' =
			VAR Choix = SELECTEDVALUE ( FiltreVigilance[libelle], "Tout" )
			RETURN IF ( Choix = "Tout" || [Niveau de vigilance interne] = Choix, 1, 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: a29355fb-aaee-44f0-9811-af7aaa9e8d3d

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Prioritaires sélectionnés' = COALESCE ( SUMX ( VALUES ( DimStation[code] ), VAR Niveau = CALCULATE ( [Niveau de vigilance interne] ) RETURN IF ( Niveau IN { "Priorité 1", "Priorité 2" } && CALCULATE ( [Filtre vigilance accepté] ) = 1, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: e85c2f89-6335-4aa4-a9d6-e63588a9955c

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Prioritaires hors nuage' = COALESCE ( SUMX ( VALUES ( DimStation[code] ), VAR Niveau = CALCULATE ( [Niveau de vigilance interne] ) VAR Actuel = CALCULATE ( [Pression actuelle station pct] ) VAR Etiage = CALCULATE ( [Pression etiage station pct] ) RETURN IF ( Niveau IN { "Priorité 1", "Priorité 2" } && CALCULATE ( [Filtre vigilance accepté] ) = 1 && ( ISBLANK ( Actuel ) || ISBLANK ( Etiage ) ), 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 96949a22-43a7-49bb-aec3-2738549fca91

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Hors nuage affiché' = FORMAT ( [Prioritaires hors nuage], "0" ) & " sur " & FORMAT ( [Prioritaires sélectionnés], "0" )
		displayFolder: 06 - Revue visuelle
		lineageTag: ac96585e-083f-4da7-a404-6eb7ad28e504

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'P1 affichées' = COALESCE ( SUMX ( VALUES ( DimStation[code] ), IF ( CALCULATE ( [Niveau de vigilance interne] ) = "Priorité 1" && CALCULATE ( [Filtre vigilance accepté] ) = 1, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: 1c8bc10c-b279-49be-9491-21e2000ba9b5

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'P2 affichées' = COALESCE ( SUMX ( VALUES ( DimStation[code] ), IF ( CALCULATE ( [Niveau de vigilance interne] ) = "Priorité 2" && CALCULATE ( [Filtre vigilance accepté] ) = 1, 1, 0 ) ), 0 )
		formatString: 0
		displayFolder: 06 - Revue visuelle
		lineageTag: b1e65007-caf6-4619-84e1-6ca422b1c857

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Priorité affichée' = SWITCH ( [Niveau de vigilance interne], "Priorité 1", "P1", "Priorité 2", "P2", [Niveau de vigilance interne] )
		displayFolder: 06 - Revue visuelle
		lineageTag: 9ef2573e-66d1-4de9-9656-ba1ab0d2e896

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Couleur texte actuelle' = SWITCH ( [Categorie actuelle station], "critique", "#a32424", "eleve", "#9d3d18", "modere", "#735b00", "faible", "#356448", "negligeable", "#1a4a3a", "#696761" )
		displayFolder: 06 - Revue visuelle
		lineageTag: c584d236-99b8-4742-a5e4-16b5d6646c19

	/// Presentation de la revue visuelle; regles metier existantes conservees.
	measure 'Couleur texte étiage' = SWITCH ( [Categorie etiage station], "critique", "#a32424", "eleve", "#9d3d18", "modere", "#735b00", "faible", "#356448", "negligeable", "#1a4a3a", "#696761" )
		displayFolder: 06 - Revue visuelle
		lineageTag: 60463ea2-29e8-4565-9c6f-f95a291bf49b

	/// Présentation seulement : l'état non évaluable reste dans la colonne Actuel. La mesure métier Motif de vigilance reste inchangée.
	measure 'Motif affiché' = SUBSTITUTE ( [Motif de vigilance], "; actuel non évaluable", "" )
		displayFolder: 06 - Revue visuelle
