		formatString: 0
		displayFolder: 07 - Disposition Markdown
		lineageTag: 5f3c71b8-b43b-4f7f-91c2-3f2c5eb0e909

	measure 'MD - Amplitude mai octobre' = VAR Mois=FILTER(ALL(DimMois),DimMois[mois_num]>=5 && DimMois[mois_num]<=10) VAR H=MAXX(Mois,[MD - Profil mensuel cumulé (m3/j)]) VAR B=MINX(Mois,[MD - Profil mensuel cumulé (m3/j)]) RETURN DIVIDE(H,B)
		formatString: 0.00
		displayFolder: 07 - Disposition Markdown
		lineageTag: d5bef9a4-93c4-48ca-847f-21c7c7fbcdef

	measure 'MD - Horodatages UTC' = "CEHQ " & FORMAT([Derniere mesure CEHQ UTC],"yyyy-MM-dd HH:mm") & " | Collecte " & FORMAT([Collecte CEHQ UTC],"yyyy-MM-dd HH:mm") & " | Génération " & FORMAT([Dernier instant UTC],"yyyy-MM-dd HH:mm") & " | Import Power BI " & FORMAT([Actualisation Power BI UTC],"yyyy-MM-dd HH:mm") & " UTC"
		displayFolder: 07 - Disposition Markdown
		lineageTag: c849c3f6-ac36-49a3-9842-16890190a919

	measure 'MD - Horodatage local' = "Génération Toronto " & SUBSTITUTE(LEFT([Generation locale],19),"T"," ") & " | Validité des débits à la génération (≤ 6 h) | Actualisation par import ; collecte et import distincts"
		displayFolder: 07 - Disposition Markdown
		lineageTag: e5656bb0-1e52-45f2-810c-927f5f2908ea

