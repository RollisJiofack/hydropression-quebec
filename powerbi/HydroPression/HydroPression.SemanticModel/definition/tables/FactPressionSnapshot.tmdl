	hierarchy 'categorie_etiage Hiérarchie'
		lineageTag: 919298be-f1a5-42ec-9467-b8c51428f800

		level categorie_etiage
			lineageTag: ed4bc563-ba17-40cd-b632-d2239d211de1
			column: categorie_etiage

	partition FactPressionSnapshot = m
		mode: import
		source =
				let
				    Source = HydroPression_Source,
				    ToUtc = (Value as any) as nullable datetime =>
				        if Value = null then null else
				        try DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.FromText(Text.From(Value)))) otherwise null,
				    GeneratedAtUtc = ToUtc(Source[generated_at]),
				    CollectedAtUtc = ToUtc(try Source[fetch_status][fetched_at] otherwise null),
				    RefreshedAtUtc = DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.FixedUtcNow())),
				    MoisCourant = Int64.From(Source[mois_courant]),
				    MoisCourantNom = Text.From(Source[mois_courant_nom]),
				    Stations = Table.FromRecords(Source[stations]),
				    Selected = Table.SelectColumns(
				        Stations,
				        {
				            "code", "date_mesure", "etat_cehq", "statut_debit_observe", "prelevements_caracterises",
				            "n_sites_amont", "n_sites_etiage", "n_sites_inactifs_mois",
				            "debit_obs_m3s", "debit_obs_dernier_connu_m3s",
				            "debit_preleve_m3s", "debit_naturel_m3s",
				            "pression_observe_pct", "categorie_observe",
				            "q27_ete_m3s", "debit_preleve_etiage_m3s",
				            "pression_etiage_pct", "categorie_etiage"
				        },
				        MissingField.UseNull
				    ),
				    AddedGeneratedAt = Table.AddColumn(Selected, "generated_at_utc", each GeneratedAtUtc, type datetime),
				    AddedCollectedAt = Table.AddColumn(AddedGeneratedAt, "collected_at_utc", each CollectedAtUtc, type datetime),
				    AddedRefreshedAt = Table.AddColumn(AddedCollectedAt, "refreshed_at_utc", each RefreshedAtUtc, type datetime),
				    AddedGeneratedLocal = Table.AddColumn(AddedRefreshedAt, "generated_at_local", each Text.From(Source[generated_at_local]), type text),
				    AddedMoisCourant = Table.AddColumn(AddedGeneratedLocal, "mois_courant", each MoisCourant, Int64.Type),
				    AddedMoisCourantNom = Table.AddColumn(AddedMoisCourant, "mois_courant_nom", each MoisCourantNom, type text),
				    AddedDateMesureUtc = Table.AddColumn(AddedMoisCourantNom, "date_mesure_utc", each ToUtc([date_mesure]), type datetime),
				    RemovedOriginalDateMesure = Table.RemoveColumns(AddedDateMesureUtc, {"date_mesure"}),
				    Typed = Table.TransformColumnTypes(
				        RemovedOriginalDateMesure,
				        {
				            {"code", type text}, {"etat_cehq", type text}, {"statut_debit_observe", type text},
				            {"n_sites_amont", Int64.Type}, {"n_sites_etiage", Int64.Type}, {"n_sites_inactifs_mois", Int64.Type},
				            {"debit_obs_m3s", type number}, {"debit_obs_dernier_connu_m3s", type number},
				            {"debit_preleve_m3s", type number}, {"debit_naturel_m3s", type number},
				            {"pression_observe_pct", type number}, {"categorie_observe", type text},
				            {"q27_ete_m3s", type number}, {"debit_preleve_etiage_m3s", type number},
				            {"pression_etiage_pct", type number}, {"categorie_etiage", type text}
				        }
				    ),
				    Caracterises = Table.TransformColumnTypes(Typed, {{"prelevements_caracterises", type logical}}),
				    Libelle = (c as nullable text) as text => Record.FieldOrDefault([critique="Critique", eleve="Élevée", modere="Modérée", faible="Faible", negligeable="Négligeable"], if c = null then "inconnu" else c, "Indéterminée"),
				    Ordre = (c as nullable text) as number => Record.FieldOrDefault([critique=1, eleve=2, modere=3, faible=4, negligeable=5], if c = null then "inconnu" else c, 6),
				    LibelleActuel = Table.AddColumn(Caracterises, "categorie_actuelle_libelle", each Libelle([categorie_observe]), type text),
				    OrdreActuel = Table.AddColumn(LibelleActuel, "categorie_actuelle_ordre", each Ordre([categorie_observe]), Int64.Type),
				    LibelleEtiage = Table.AddColumn(OrdreActuel, "categorie_etiage_libelle", each Libelle([categorie_etiage]), type text),
				    OrdreEtiage = Table.AddColumn(LibelleEtiage, "categorie_etiage_ordre", each Ordre([categorie_etiage]), Int64.Type),
				    LibellePageRisque = Table.AddColumn(OrdreEtiage, "categorie_etiage_page2_libelle", each if [categorie_etiage] = "inconnu" and [prelevements_caracterises] = false and [q27_ete_m3s] <> null and [q27_ete_m3s] > 0 then "Négligeable" else [categorie_etiage_libelle], type text),
				    OrdrePageRisque = Table.AddColumn(LibellePageRisque, "categorie_etiage_page2_ordre", each if [categorie_etiage_page2_libelle] = "Négligeable" then 5 else [categorie_etiage_ordre], Int64.Type)
				in
				    OrdrePageRisque

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

