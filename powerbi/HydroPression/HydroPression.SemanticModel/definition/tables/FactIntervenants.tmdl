	column activite_mois_libelle
		dataType: string
		lineageTag: ffeb2531-ebe1-4ea4-a01e-0e76dc54cfa9
		summarizeBy: none
		sourceColumn: activite_mois_libelle

	partition FactIntervenants = m
		mode: import
		source =
				let
				    Source = HydroPression_Source,
				    GeneratedAtUtc = DateTimeZone.RemoveZone(DateTimeZone.FromText(Source[generated_at])),
				    MoisCourant = Int64.From(Source[mois_courant]),
				    Stations = Table.FromRecords(Source[stations]),
				    Selected = Table.SelectColumns(Stations, {"code", "plan_deau", "bv_prim", "intervenants"}),
				    RenamedStation = Table.RenameColumns(Selected, {{"code", "station"}}),
				    ExpandedList = Table.ExpandListColumn(RenamedStation, "intervenants"),
				    Filtered = Table.SelectRows(ExpandedList, each [intervenants] <> null),
				    ExpandedRecords = Table.ExpandRecordColumn(
				        Filtered,
				        "intervenants",
				        {
				            "rang",
				            "nom_intervenant",
				            "num_site",
				            "secteur_scian",
				            "municipalite",
				            "debit_etiage_m3s",
				            "volume_annuel_moyen_Mm3",
				            "premiere_annee",
				            "derniere_annee",
				            "debit_mois_01_m3s",
				            "debit_mois_02_m3s",
				            "debit_mois_03_m3s",
				            "debit_mois_04_m3s",
				            "debit_mois_05_m3s",
				            "debit_mois_06_m3s",
				            "debit_mois_07_m3s",
				            "debit_mois_08_m3s",
				            "debit_mois_09_m3s",
				            "debit_mois_10_m3s",
				            "debit_mois_11_m3s",
				            "debit_mois_12_m3s",
				            "debit_mois_courant_m3s",
				            "actif_mois_courant"
				        },
				        {
				            "rang",
				            "nom_intervenant",
				            "num_site",
				            "secteur_scian",
				            "municipalite",
				            "debit_etiage_m3s",
				            "volume_annuel_moyen_Mm3",
				            "premiere_annee",
				            "derniere_annee",
				            "debit_mois_01_m3s",
				            "debit_mois_02_m3s",
				            "debit_mois_03_m3s",
				            "debit_mois_04_m3s",
				            "debit_mois_05_m3s",
				            "debit_mois_06_m3s",
				            "debit_mois_07_m3s",
				            "debit_mois_08_m3s",
				            "debit_mois_09_m3s",
				            "debit_mois_10_m3s",
				            "debit_mois_11_m3s",
				            "debit_mois_12_m3s",
				            "debit_mois_courant_m3s",
				            "actif_mois_courant"
				        }
				    ),
				    AddedGeneratedAt = Table.AddColumn(
				        ExpandedRecords,
				        "generated_at_utc",
				        each GeneratedAtUtc,
				        type datetime
				    ),
				    AddedMoisCourant = Table.AddColumn(
				        AddedGeneratedAt,
				        "mois_courant",
				        each MoisCourant,
				        Int64.Type
				    ),
				    Typed = Table.TransformColumnTypes(
				        AddedMoisCourant,
				        {
				            {"station", type text},
				            {"plan_deau", type text},
				            {"bv_prim", type text},
				            {"rang", Int64.Type},
				            {"nom_intervenant", type text},
				            {"num_site", type text},
				            {"secteur_scian", type text},
				            {"municipalite", type text},
				            {"debit_etiage_m3s", type number},
				            {"volume_annuel_moyen_Mm3", type number},
				            {"premiere_annee", Int64.Type},
				            {"derniere_annee", Int64.Type},
				            {"debit_mois_01_m3s", type number},
				            {"debit_mois_02_m3s", type number},
				            {"debit_mois_03_m3s", type number},
				            {"debit_mois_04_m3s", type number},
				            {"debit_mois_05_m3s", type number},
				            {"debit_mois_06_m3s", type number},
				            {"debit_mois_07_m3s", type number},
				            {"debit_mois_08_m3s", type number},
				            {"debit_mois_09_m3s", type number},
				            {"debit_mois_10_m3s", type number},
				            {"debit_mois_11_m3s", type number},
				            {"debit_mois_12_m3s", type number},
				            {"debit_mois_courant_m3s", type number},
				            {"actif_mois_courant", type logical}
				        }
				    ),
				    Identifiants = Table.TransformColumns(Typed, {{"num_site", (v as nullable text) as nullable text => if v = null then null else if Text.EndsWith(v, ".0") and Text.Length(v) > 2 and Text.Select(Text.Start(v, Text.Length(v)-2), {"0".."9"}) = Text.Start(v, Text.Length(v)-2) then Text.Start(v, Text.Length(v)-2) else v, type text}}),
				    Activite = Table.AddColumn(Identifiants, "activite_mois_libelle", each if [actif_mois_courant] = null then "Non renseigné" else if [actif_mois_courant] then "Oui" else "Non", type text)
				in
				    Activite

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

